 }
+
+int verify_client_certificate(gnutls_session_t session) {
+  unsigned int status = 0;
+  auto rv = gnutls_certificate_verify_peers3(session, nullptr, &status);
+  if (rv < 0 || status != 0) {
+    std::cerr << "FLEETQOX_PUBLIC_MTLS_REJECT verify_result=" << rv
+              << " verify_status=" << status << std::endl;
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+
+  unsigned int peer_count = 0;
+  const auto *peers = gnutls_certificate_get_peers(session, &peer_count);
+  if (peers == nullptr || peer_count == 0) {
+    std::cerr << "FLEETQOX_PUBLIC_MTLS_REJECT reason=missing_peer_certificate"
+              << std::endl;
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+
+  gnutls_x509_crt_t certificate;
+  rv = gnutls_x509_crt_init(&certificate);
+  if (rv < 0) {
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  rv = gnutls_x509_crt_import(certificate, &peers[0], GNUTLS_X509_FMT_DER);
+  if (rv < 0) {
+    gnutls_x509_crt_deinit(certificate);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+
+  if (gnutls_x509_crt_check_key_purpose(
+        certificate, GNUTLS_KP_TLS_WWW_CLIENT, 0) == 0) {
+    std::cerr << "FLEETQOX_PUBLIC_MTLS_REJECT reason=missing_client_auth_eku"
+              << std::endl;
+    gnutls_x509_crt_deinit(certificate);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+
+  const char *required_uri =
+      std::getenv("FLEETQOX_GNUTLS_REQUIRED_CLIENT_URI_SAN");
+  bool uri_matched = required_uri == nullptr || required_uri[0] == '\0';
+  std::string observed_uri;
+  for (unsigned int index = 0; !uri_matched; ++index) {
+    std::array<char, 2048> value{};
+    size_t value_size = value.size();
+    unsigned int critical = 0;
+    const int san_type = gnutls_x509_crt_get_subject_alt_name(
+        certificate, index, value.data(), &value_size, &critical);
+    if (san_type == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+      break;
+    }
+    if (san_type < 0) {
+      continue;
+    }
+    if (san_type == GNUTLS_SAN_URI) {
+      observed_uri.assign(value.data(), value_size);
+      uri_matched = observed_uri == required_uri;
+    }
+  }
+  if (!uri_matched) {
+    std::cerr << "FLEETQOX_PUBLIC_MTLS_REJECT reason=uri_san_mismatch"
+              << " required_uri=" << required_uri
+              << " observed_uri=" << observed_uri << std::endl;
+    gnutls_x509_crt_deinit(certificate);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+
+  std::array<char, 1024> subject{};
+  size_t subject_size = subject.size();
+  if (gnutls_x509_crt_get_dn(
+        certificate, subject.data(), &subject_size) < 0) {
+    subject[0] = '\0';
+  }
+  std::cerr << "FLEETQOX_PUBLIC_MTLS_VERIFIED subject=" << subject.data();
+  if (required_uri != nullptr && required_uri[0] != '\0') {
+    std::cerr << " uri_san=" << required_uri;
+  }
+  std::cerr << std::endl;
+  gnutls_x509_crt_deinit(certificate);
+  return 0;
+}
