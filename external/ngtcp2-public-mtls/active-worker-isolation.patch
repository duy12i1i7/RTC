+void Server::schedule_backend_identity_locked(const std::string &identity) {
+  auto tasks_it = backend_identity_tasks_.find(identity);
+  if (tasks_it == backend_identity_tasks_.end() ||
+      tasks_it->second.empty() ||
+      backend_ready_identity_set_.contains(identity)) {
+    return;
+  }
+  auto active_it = backend_identity_active_counts_.find(identity);
+  auto active = active_it == backend_identity_active_counts_.end()
+                    ? 0
+                    : active_it->second;
+  if (active >= backend_per_identity_active_limit_) {
+    return;
+  }
+  backend_ready_identities_.push_back(identity);
+  backend_ready_identity_set_.insert(identity);
+}
