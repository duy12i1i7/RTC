+bool Server::submit_backend_request(Handler *handler,
+                                    FleetQoxBackendDispatch request) {
+  std::lock_guard<std::mutex> lock(backend_mutex_);
+  if (backend_stopping_ || backend_socket_.empty() ||
+      backend_tasks_.size() >= backend_queue_capacity_) {
+    return false;
+  }
+  backend_tasks_.push_back(
+      {handler, handler->backend_generation(), std::move(request)});
+  auto pending = backend_tasks_.size();
+  backend_cv_.notify_one();
+  std::cerr << "FLEETQOX_STATE_BACKEND_ASYNC_QUEUED pending=" << pending
+            << std::endl;
+  return true;
+}
+
+void Server::backend_worker_loop() {
+  for (;;) {
+    BackendTask task;
+    {
+      std::unique_lock<std::mutex> lock(backend_mutex_);
+      backend_cv_.wait(
+          lock, [this] { return backend_stopping_ || !backend_tasks_.empty(); });
+      if (backend_stopping_ && backend_tasks_.empty()) {
+        return;
+      }
+      task = std::move(backend_tasks_.front());
+      backend_tasks_.pop_front();
+    }
+    auto response = fleetqox_backend_request(
+        backend_socket_, task.request.method, task.request.path,
+        task.request.client_identity, task.request.body,
+        task.request.path_telemetry);
+    BackendCompletion completion{
+        task.handler,
+        task.handler_generation,
+        task.request.stream_id,
+        response.has_value(),
+        response ? response->status : 502,
+        response ? std::move(response->content_type) : std::string{},
+        response ? std::move(response->body) : std::string{},
+    };
+    std::lock_guard<std::mutex> lock(backend_mutex_);
+    if (!backend_stopping_) {
+      backend_completions_.push_back(std::move(completion));
+      ev_async_send(loop_, &backend_async_);
+    }
+  }
+}
+
+void Server::drain_backend_completions() {
+  std::deque<BackendCompletion> completions;
+  {
+    std::lock_guard<std::mutex> lock(backend_mutex_);
+    completions.swap(backend_completions_);
+  }
+  for (auto &completion : completions) {
+    Handler *handler = nullptr;
+    for (const auto &entry : handlers_) {
+      auto candidate = entry.second;
+      if (candidate == completion.handler &&
+          candidate->backend_generation() == completion.handler_generation) {
+        handler = candidate;
+        break;
+      }
+    }
+    if (handler == nullptr) {
+      std::cerr << "FLEETQOX_STATE_BACKEND_DROPPED_HANDLER stream_id="
+                << completion.stream_id << std::endl;
+      continue;
+    }
+    if (completion.available) {
+      std::cerr << "FLEETQOX_STATE_BACKEND_RESPONSE status="
+                << completion.status
+                << " body_bytes=" << completion.body.size() << std::endl;
+    } else {
+      std::cerr << "FLEETQOX_STATE_BACKEND_UNAVAILABLE" << std::endl;
+    }
+    if (handler->complete_backend_response(
+            completion.stream_id, completion.available, completion.status,
+            std::move(completion.content_type), std::move(completion.body)) !=
+        0) {
+      std::cerr << "FLEETQOX_STATE_BACKEND_COMPLETION_FAILED stream_id="
+                << completion.stream_id << std::endl;
+    }
+  }
+}
+
+void Server::stop_backend_dispatcher() {
+  {
+    std::lock_guard<std::mutex> lock(backend_mutex_);
+    backend_stopping_ = true;
+    backend_tasks_.clear();
+  }
+  backend_cv_.notify_all();
+  for (auto &worker : backend_workers_) {
+    if (worker.joinable()) {
+      worker.join();
+    }
+  }
+  backend_workers_.clear();
+  if (backend_async_started_) {
+    ev_async_stop(loop_, &backend_async_);
+    backend_async_started_ = false;
+  }
+  std::lock_guard<std::mutex> lock(backend_mutex_);
+  backend_tasks_.clear();
+  backend_completions_.clear();
+}
